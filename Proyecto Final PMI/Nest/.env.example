# Copia este archivo como .env junto a app.py y completa los valores. .env está en .gitignore: no lo subas.
# Nunca escribas aquí tokens ni claves reales dentro de .env.example.

# Supabase (solo si ejecutas con --supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Demo local
# CUNA_DB=datos/demo.sqlite3

# Telegram (SCRUM-24). Crea el bot con BotFather y pega aquí su token. Es un secreto.
TELEGRAM_BOT_TOKEN=
# Nombre del bot sin @. Solo sirve para mostrar el enlace t.me en la página. No es secreto.
TELEGRAM_BOT_USERNAME=
# Solo para pruebas con un servidor falso. Déjala vacía para usar https://api.telegram.org
TELEGRAM_API_BASE=
